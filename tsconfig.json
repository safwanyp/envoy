{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["./.cloudflare/types/index.d.ts"]
  },
  "include": ["src/**/*", "scripts/**/*", "cloudflare.config.ts", ".cloudflare/types/index.d.ts"]
}
